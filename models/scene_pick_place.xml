<mujoco model="kinova_leap pick-place scene">
  <include file="scene_kinova_leap.xml"/>

  <!-- Elliptic friction cone: the default pyramidal approximation degenerates at high
       friction (its basis edges n±mu*t go near-tangential), which let the mu=4 red box
       equilibrate ~6.7mm INTO the floor instead of ~0.1mm. Elliptic represents high-mu
       contacts exactly (and is the MuJoCo-recommended cone for grasping).
       impratio=10: at the default impratio=1 the FRICTION (tangential) constraints are as
       soft as the normal ones, so a firmly-gripped box slides straight DOWN between the
       fingers (pads stay put, contact walks up the box face) at only 3-6% friction
       utilization pure tangential softness, not a cone violation. An isolated two-plate
       pinch (scratchpad/pinch_test.py) confirmed impratio is the lever: box creep over 4s
       fell ~20x from impratio 1 (2.5mm) to 20 (0.13mm), monotonic, independent of
       solref/condim/cone. Set to 10 (a stable middle: strong tangential hold without the
       lift-transient excitation seen at >=20 in the full arm+squeeze pipeline). -->
  <option cone="elliptic" impratio="100"/>

  <worldbody>
    <!-- CLEAR-THE-TABLE benchmark. The robot base is mounted ON the wood table (base_link
         raised to TABLE_TOP_Z=0.625 in the loader) at (0,0); the table is centered at
         (0,0.25) with its top at z=0.625. Objects co-exist on the table in front of the base
         (+y, ~0.3-0.45m reach, level with the base = easy IK regime), each resting at
         z=TABLE_TOP_Z + half-height, at distinct XY (>=0.10 apart). The loader keeps the
         bodies named in --objects and prunes the rest; nq = 23 + 7*N for N kept objects.
         Contact sites use the +x inward-normal convention; _c1/_c2 are the antipodal grasp
         points. condim=6 + torsional/rolling friction match the fingertip pads (both grasp
         geoms carry the torsional term to resist twist). Friction/mass VARY per object for
         the parametric deviations; the shape+condim baseline is held fixed.
           obj_red_box    box    mass=0.25  mu=2.0   (baseline)
           obj_box_lowmu  box    mass=0.25  mu=1.2   (0.6x friction)
           obj_box_heavy  box    mass=0.35  mu=2.0   (1.4x mass)
           obj_red_sphere sphere mass=0.25  mu=2.0   (orange/lemon/ball stand-in) -->
    <!-- Objects on the LEFT (-x), spread along the table LENGTH (x); bin on the RIGHT (+x).
         This matches the operator's table layout after the world_from_board x<->y swap
         (calibration/teleop_config.json), so operator-left maps to robot-left. All within
         reach (dist < 0.55 m from the base at origin). >=0.12 apart along x. -->
    <body name="obj_red_box" pos="-0.38 0.30 0.665">
      <freejoint/>
      <geom name="obj_red_box_geom" type="box" size="0.040 0.040 0.040"
        rgba="0.85 0.15 0.15 1" mass="0.25" friction="2.0 0.05 0.005" condim="6"/>
      <site name="obj_red_box_c1" pos="-0.040 0 0" quat="1 0 0 0"/>
      <site name="obj_red_box_c2" pos=" 0.040 0 0" quat="0 0 1 0"/>
    </body>

    <body name="obj_box_lowmu" pos="-0.26 0.30 0.665">
      <freejoint/>
      <geom name="obj_box_lowmu_geom" type="box" size="0.040 0.040 0.040"
        rgba="0.85 0.55 0.15 1" mass="0.25" friction="1.2 0.05 0.005" condim="6"/>
      <site name="obj_box_lowmu_c1" pos="-0.040 0 0" quat="1 0 0 0"/>
      <site name="obj_box_lowmu_c2" pos=" 0.040 0 0" quat="0 0 1 0"/>
    </body>

    <body name="obj_box_heavy" pos="-0.14 0.30 0.665">
      <freejoint/>
      <geom name="obj_box_heavy_geom" type="box" size="0.040 0.040 0.040"
        rgba="0.55 0.15 0.55 1" mass="0.35" friction="2.0 0.05 0.005" condim="6"/>
      <site name="obj_box_heavy_c1" pos="-0.040 0 0" quat="1 0 0 0"/>
      <site name="obj_box_heavy_c2" pos=" 0.040 0 0" quat="0 0 1 0"/>
    </body>

    <!-- Sphere stand-in (orange/lemon/sports-ball). Antipodal equatorial contact sites at
         (+/-radius, 0, 0): local +x points inward toward the center for both, a valid
         antipodal grasp pair. object_defs / _RANDOMIZE_OBJ_INFO already register this body
         name, so no Python change is needed to make it pickable. -->
    <body name="obj_red_sphere" pos="-0.02 0.30 0.660">
      <freejoint/>
      <geom name="obj_red_sphere_geom" type="sphere" size="0.035"
        rgba="0.95 0.55 0.15 1" mass="0.25" friction="2.0 0.05 0.005" condim="6"/>
      <site name="obj_red_sphere_c1" pos="-0.035 0 0" quat="1 0 0 0"/>
      <site name="obj_red_sphere_c2" pos=" 0.035 0 0" quat="0 0 1 0"/>
    </body>

    <!-- Bin/tray (fixed place target) at (0.40, 0.30) on the table top (z=0.625). A clean
         rectangular open box: a flat base + 4 upright walls flush with the base edges (no
         gaps). Inner footprint ~0.20 x 0.20, walls ~0.05 tall. Kept the geom names
         bowl_base/bowl_wall_* so the arm's collision list and the 3D-containment arrival
         test (object XY within +/-BIN_HALF of center AND z between the base top and wall top)
         work unchanged. Base top at z=0.635; wall top at z=0.685.
         Wall segments overlap at the corners (half-extents include the wall thickness) so the
         box is fully closed — no open corners. -->
    <geom name="bowl_base" type="box" pos="0.40 0.30 0.630" size="0.12 0.12 0.005"
      rgba="0.25 0.35 0.85 1" contype="1" conaffinity="1"/>
    <geom name="bowl_wall_n" type="box" pos="0.40 0.415 0.660" size="0.12 0.008 0.030"
      rgba="0.30 0.45 0.90 0.85" contype="1" conaffinity="1"/>
    <geom name="bowl_wall_s" type="box" pos="0.40 0.185 0.660" size="0.12 0.008 0.030"
      rgba="0.30 0.45 0.90 0.85" contype="1" conaffinity="1"/>
    <geom name="bowl_wall_e" type="box" pos="0.515 0.30 0.660" size="0.008 0.12 0.030"
      rgba="0.30 0.45 0.90 0.85" contype="1" conaffinity="1"/>
    <geom name="bowl_wall_w" type="box" pos="0.285 0.30 0.660" size="0.008 0.12 0.030"
      rgba="0.30 0.45 0.90 0.85" contype="1" conaffinity="1"/>
    <!-- Kept named place_red_site so the trial-logger place-site lookup resolves via its
         existing _DEFAULT_PLACE_SITE fallback with no Python change. -->
    <site name="place_red_site" pos="0.40 0.30 0.660" size="0.001"/>

    <!-- Contact-point marker spheres for GraspPlanner3D visualisation. -->
    <body name="cp1_body" mocap="true">
      <geom name="cp1" type="sphere" size="0.006"
            rgba="1 0.2 0.2 0.6" contype="0" conaffinity="0"/>
    </body>
    <body name="cp2_body" mocap="true">
      <geom name="cp2" type="sphere" size="0.006"
            rgba="0.2 0.4 1 0.6" contype="0" conaffinity="0"/>
    </body>

    <!-- Live NLP grasp-recommendation markers (contact_aware_teleop mode). Larger
         and translucent so they read as "suggested" contacts, distinct from the
         planner's own cp1/cp2 verify markers. rec1=thumb (green), rec2=index (cyan). -->
    <body name="rec1_body" mocap="true">
      <geom name="rec1" type="sphere" size="0.010"
            rgba="0.2 1 0.3 0.4" contype="0" conaffinity="0"/>
    </body>
    <body name="rec2_body" mocap="true">
      <geom name="rec2" type="sphere" size="0.010"
            rgba="0.2 0.9 1 0.4" contype="0" conaffinity="0"/>
    </body>
  </worldbody>

  <!-- Test keyframes removed: they were 30-vec (23 robot + 7 for ONE object) autonomous-mode
       test poses sized for the single-object floor scene. With N co-present objects on the
       table nq = 23 + 7*N, so those keyframes are invalid. Regenerate for the multi-object
       table scene via scratchpad/sample_keyframes.py if autonomous replay poses are needed. -->
</mujoco>
