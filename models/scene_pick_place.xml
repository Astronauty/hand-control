<mujoco model="kinova_leap pick-place scene">
  <include file="scene_kinova_leap.xml"/>

  <!-- Elliptic friction cone: the default pyramidal approximation degenerates at high
       friction (its basis edges n±mu*t go near-tangential), which let the mu=4 red box
       equilibrate ~6.7mm INTO the floor instead of ~0.1mm. Elliptic represents high-mu
       contacts exactly (and is the MuJoCo-recommended cone for grasping). -->
  <option cone="elliptic"/>

  <worldbody>
    <!-- Pick area: visual-only reference marker, 30 cm × 30 cm -->
    <geom name="pick_area_marker" type="box" size="0.15 0.15 0.0005" pos="0.65 0.5 0.001"
      rgba="0.6 0.6 0.6 0.35" contype="0" conaffinity="0"/>

    <!-- RED category: box + sphere
         z = half-height so each object rests on the floor at startup.
         Contact sites use the +x inward-normal convention (local x-axis = inward surface normal). -->
    <body name="obj_red_box" pos="0.60 0.42 0.040">
      <freejoint/>
      <geom name="obj_red_box_geom" type="box" size="0.040 0.040 0.040"
        rgba="0.85 0.15 0.15 1" mass="0.25" friction="2.0 0.05 0.001" condim="3"/>
      <site name="obj_red_box_c1" pos="-0.040 0 0" quat="1 0 0 0"/>
      <site name="obj_red_box_c2" pos=" 0.040 0 0" quat="0 0 1 0"/>
    </body>
    


    <!-- BLUE category: cylinder
         Capsule: size=(radius, half-cylinder-length); rest height = radius + half-length. -->
    <!-- <body name="obj_blue_cylinder" pos="0.55 0.55 0.037">
      <freejoint/>
      <geom name="obj_blue_cylinder_geom" type="cylinder" size="0.037 0.037"
        rgba="0.15 0.25 0.85 1" mass="0.5" friction="1 0.05 0.001" condim="3"/>
      <site name="obj_blue_cylinder_c1" pos="-0.037 0 0" quat="1 0 0 0"/>
      <site name="obj_blue_cylinder_c2" pos=" 0.037 0 0" quat="0 0 1 0"/>
    </body> -->

    <!-- GREEN category: box + cylinder -->
    <!-- <body name="obj_green_box" pos="0.60 0.62 0.030">
      <freejoint/>
      <geom name="obj_green_box_geom" type="box" size="0.030 0.034 0.030"
        rgba="0.15 0.75 0.20 1" mass="0.5" friction="1 0.05 0.001" condim="3"/>
      <site name="obj_green_box_c1" pos="-0.030 0 0" quat="1 0 0 0"/>
      <site name="obj_green_box_c2" pos=" 0.030 0 0" quat="0 0 1 0"/>
    </body> -->

    <!-- Place areas: one per color category, color-matched, below the robot.
         Laid out along -y (fixed x), spaced 0.2m apart. -->
    <site name="place_red_site" pos="0.6 -0.15 0.001" size="0.001"/>
    <geom name="place_red_marker" type="box" size="0.08 0.08 0.0005"
      pos="0.6 -0.4 0.001" rgba="0.85 0.15 0.15 0.35" contype="0" conaffinity="0"/>

    <site name="place_blue_site" pos="0.6 -0.35 0.001" size="0.001"/>
    <geom name="place_blue_marker" type="box" size="0.08 0.08 0.0005"
      pos="0.6 -0.6 0.001" rgba="0.15 0.25 0.85 0.35" contype="0" conaffinity="0"/>

    <site name="place_green_site" pos="0.6 -0.55 0.001" size="0.001"/>
    <geom name="place_green_marker" type="box" size="0.08 0.08 0.0005"
      pos="0.6 -0.8 0.001" rgba="0.15 0.75 0.20 0.35" contype="0" conaffinity="0"/>

    <!-- Contact-point marker spheres for GraspPlanner3D visualisation. -->
    <body name="cp1_body" mocap="true">
      <geom name="cp1" type="sphere" size="0.006"
            rgba="1 0.2 0.2 0.6" contype="0" conaffinity="0"/>
    </body>
    <body name="cp2_body" mocap="true">
      <geom name="cp2" type="sphere" size="0.006"
            rgba="0.2 0.4 1 0.6" contype="0" conaffinity="0"/>
    </body>

    <!-- Live NLP grasp-recommendation markers (contact_aware_teleop mode). Larger
         and translucent so they read as "suggested" contacts, distinct from the
         planner's own cp1/cp2 verify markers. rec1=thumb (green), rec2=index (cyan). -->
    <body name="rec1_body" mocap="true">
      <geom name="rec1" type="sphere" size="0.010"
            rgba="0.2 1 0.3 0.4" contype="0" conaffinity="0"/>
    </body>
    <body name="rec2_body" mocap="true">
      <geom name="rec2" type="sphere" size="0.010"
            rgba="0.2 0.9 1 0.4" contype="0" conaffinity="0"/>
    </body>
  </worldbody>
</mujoco>
