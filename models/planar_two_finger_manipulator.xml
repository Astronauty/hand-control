<mujoco model="planar_two_finger_manipulator">
    <compiler angle="radian"/>
    <option timestep="0.001" gravity="0.0 -9.81 0.0"/>

    <visual>
        <rgba haze="0.15 0.25 0.35 1"/>
        <quality shadowsize="8192"/>
    </visual> 

    <asset>
        <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0.1 0.1 0.2" width="512" height="3072"/>
        <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
            markrgb="0.8 0.8 0.8" width="1000" height="1000"/>
        <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.0"/>
    </asset>


    <keyframe>
        <key name="grasp_init"
             qpos="0.0 0.0 -0.50 -0.50 -0.50 0.50 0.50 0.50  0 0 0  0 0 0  0 0 0"
             ctrl="0.0 0.0 -0.50 -0.50 -0.50 0.50 0.50 0.50"/>
    </keyframe>

    <worldbody>
        <!-- Scene Visualization -->
        <!-- <camera name="cam0" pos="0.0 0.8 4.0" xyaxes="1 0 0 0 0.966 -0.258"/> -->
        <camera name="cam0" pos="0.0 0.0 4.0" xyaxes="1 0 0 0 1 0"/>

        <!-- <light pos="0 -1 2"/> -->

        <light pos="0 0 3" dir="0 0 -1" directional="true" ambient="0.3 0.3 0.3" diffuse="0.6 0.6 0.6" specular="0.1 0.1 0.1"/>
        <light pos="0 3 1"  dir="0 -1 -0.3" directional="true" ambient="0.0 0.0 0.0" diffuse="0.4 0.4 0.4" specular="0.0 0.0 0.0"/>


        <geom type="plane" material="groundplane" pos="0 -0.8 0" quat="0.7071068 -0.7071068 0 0" size="1 1 1" rgba="1 1 1 1" contype="1" conaffinity="1"/>
        

        <!-- Right Hand Index Finger -->
        <body name="base" pos="0 0 0">
            <geom type="box" size="0.1 0.05 0.01" rgba="0.5 0.3 0.3 0.5" mass="0.5"/>
            <joint name="Th_base_x" type="slide" axis="1 0 0" damping="1" range="-0.65 0.65" limited="true"/>
            <joint name="Th_base_y" type="slide" axis="0 1 0" damping="1" range="-1.2 0.2" limited="true"/>

            <body name="right_index_proximal_link" pos="0.1 0 0">
                <geom name="index_proximal" type="capsule" size="0.02" fromto="0 0 0 0.1 0 0" mass="0.1" group="1" conaffinity="0"/>
                <joint name="right_index_MCP_joint" type="hinge" axis="0 0 1" damping="0.01" range="-2.09 0.52" limited="true"/>

                <body name="right_index_medial_link" pos="0.1 0 0">
                    <joint name="right_index_PIP_joint" type="hinge" axis="0 0 1" damping="0.01" range="-2.09 0.0" limited="true"/>
                    <geom name="index_medial" type="capsule" size="0.02" fromto="0 0 0 0.1 0 0" mass="0.1" group="1" conaffinity="0"/>

                    <body name="right_index_distal_link" pos="0.1 0 0">
                        <joint name="right_index_DIP_joint" type="hinge" axis="0 0 1" damping="0.01" range="-1.57 0.0" limited="true"/>
                        <geom name="index_distal" type="capsule" size="0.02" fromto="0 0 0 0.1 0 0" mass="0.1" group="1" rgba="0.5 0.5 0.5 0.3"/>
                        <!-- <site name="index_touch" pos="0.085 -0.015 0" size="0.01" group="1" rgba="255 255 0 0.8"/> -->
                        <site name="index_touch" pos="0.12 -0.0 0" size="0.01" group="1" rgba="255 255 0 0.8"/>

                            
                    </body>
                </body>
            </body>

            <!-- Right Hand Thumb Finger -->
            <body name="right_thumb_proximal_link" pos="-0.1 0 0">
                <geom name="thumb_proximal" type="capsule" size="0.02" fromto="0 0 0 -0.1 0 0" mass="0.1" group="1" conaffinity="0"/>
                <joint name="right_thumb_MCP_joint" type="hinge" axis="0 0 1" damping="0.01" range="-0.52 2.09" limited="true"/>

                <body name="right_thumb_medial_link" pos="-0.1 0 0">
                    <joint name="right_thumb_PIP_joint" type="hinge" axis="0 0 1" damping="0.01" range="0.0 2.09" limited="true"/>
                    <geom name="thumb_medial" type="capsule" size="0.02" fromto="0 0 0 -0.1 0 0" mass="0.1" group="1" conaffinity="0"/>

                    <body name="right_thumb_distal_link" pos="-0.1 0 0">
                        <joint name="right_thumb_DIP_joint" type="hinge" axis="0 0 1" damping="0.01" range="0.0 1.57" limited="true"/>
                        <geom name="thumb_distal" type="capsule" size="0.02" fromto="0 0 0 -0.1 0 0" mass="0.1" group="1"/>
                        <!-- <site name="thumb_touch" pos="-0.085 -0.015 0" size="0.01" group="1" rgba="255 255 0 0.8"/> -->
                        <site name="thumb_touch" pos="-0.12 -0.0 0" size="0.01" group="1" rgba="255 255 0 0.8"/>

                    </body>
                </body>
            </body>
        </body>

        <!-- Contact point markers (initially hidden at origin) -->
        <site name="contact_p1" type="sphere" size="0.01" 
            rgba="1 0 0 0.8" pos="0 0 -10"/>  <!-- Red sphere for thumb -->
        
        <site name="contact_p2" type="sphere" size="0.01" 
            rgba="0 1 0 0.8" pos="0 0 -10"/>  <!-- Green sphere for index -->




        <!-- <body name="Th_base" pos="0 0 0">
            <geom type="box" size="0.1 0.05 0.01" rgba="0.5 0.3 0.3 0.5"/>

        </body> -->


        <body name="obj1" pos="-0.45 -0.75 0.0">
            <joint name="obj1_tx" type="slide" axis="1 0 0" damping="2"/>
            <joint name="obj1_ty" type="slide" axis="0 1 0" damping="2"/>
            <joint name="obj1_rz" type="hinge" axis="0 0 1" damping="2"/>
            <geom type="box" size="0.05 0.05 0.05" rgba="0.3 0.3 0.5 0.4" mass="0.1" friction="1 0.1 0.1"/>
            <site name="index_box_touch" pos="0.055 0.0 0.0" size="0.007" group="1" rgba="0 1 0 0.8"/>
            <site name="thumb_box_touch" pos="-0.055 0.0 0.0" size="0.007" group="1" rgba="0 1 0 0.8"/>
        </body>

        <body name="obj2" pos="0.45 -0.75 0.0">
            <joint name="obj2_tx" type="slide" axis="1 0 0" damping="2"/>
            <joint name="obj2_ty" type="slide" axis="0 1 0" damping="2"/>
            <joint name="obj2_rz" type="hinge" axis="0 0 1" damping="2"/>
            <geom type="box" size="0.05 0.05 0.05" rgba="0.5 0.3 0.1 0.4" mass="0.1" friction="1 0.1 0.1"/>
            <site name="index_box_touch_2" pos="0.055 0.0 0.0" size="0.007" group="1" rgba="0 1 0 0.8"/>
            <site name="thumb_box_touch_2" pos="-0.055 0.0 0.0" size="0.007" group="1" rgba="0 1 0 0.8"/>
        </body>

        <!-- Cylinder object (key 3) — visually distinct round shape centred in the scene -->
        <body name="obj3" pos="0.0 -0.75 0.0">
            <joint name="obj3_tx" type="slide" axis="1 0 0" damping="2"/>
            <joint name="obj3_ty" type="slide" axis="0 1 0" damping="2"/>
            <joint name="obj3_rz" type="hinge" axis="0 0 1" damping="2"/>
            <geom type="cylinder" size="0.05 0.05" rgba="0.2 0.5 0.4 0.4" mass="0.1" friction="1 0.1 0.1"/>
            <site name="index_cyl_touch" pos="0.055 0.0 0.0" size="0.007" group="1" rgba="0 1 0 0.8"/>
            <site name="thumb_cyl_touch" pos="-0.055 0.0 0.0" size="0.007" group="1" rgba="0 1 0 0.8"/>
        </body>

    </worldbody>

    <!-- Position control -->
    <!-- <actuator>
        <position name="Th_base_x_act" joint="Th_base_x" kp="100" dampratio="1" ctrllimited="false"/>
        <position name="Th_base_y_act" joint="Th_base_y" kp="100" dampratio="1" ctrllimited="false"/>

        <position name="right_index_MCP_joint" joint="right_index_MCP_joint" kp="2" dampratio="1" ctrllimited="false"/> 
        <position name="right_index_PIP_joint" joint="right_index_PIP_joint" kp="2" dampratio="1" ctrllimited="false"/>
        <position name="right_index_DIP_joint" joint="right_index_DIP_joint" kp="2" dampratio="1" ctrllimited="false"/>

        <position joint="right_thumb_MCP_joint" kp="1" dampratio="1" ctrllimited="false"/> 
        <position joint="right_thumb_PIP_joint" kp="1" dampratio="1" ctrllimited="false"/>
        <position joint="right_thumb_DIP_joint" kp="1" dampratio="1" ctrllimited="false"/>
    </actuator>
        <position name="right_thumb_MCP_joint" joint="right_thumb_MCP_joint" kp="1" dampratio="1" ctrllimited="false"/> 
        <position name="right_thumb_PIP_joint" joint="right_thumb_PIP_joint" kp="1" dampratio="1" ctrllimited="false"/>
        <position name="right_thumb_DIP_joint" joint="right_thumb_DIP_joint" kp="1" dampratio="1" ctrllimited="false"/>
    </actuator> -->

    <!-- Torque Control -->
    <actuator>
        <motor name="Th_base_x_act" joint="Th_base_x" ctrllimited="true" ctrlrange="-20 20"/>
        <motor name="Th_base_y_act" joint="Th_base_y" ctrllimited="true" ctrlrange="-20 20"/>

        <motor name="right_index_MCP_joint" joint="right_index_MCP_joint" ctrllimited="true" ctrlrange="-1 1"/> 
        <motor name="right_index_PIP_joint" joint="right_index_PIP_joint" ctrllimited="true" ctrlrange="-1 1"/>
        <motor name="right_index_DIP_joint" joint="right_index_DIP_joint" ctrllimited="true" ctrlrange="-1 1"/>

        <motor name="right_thumb_MCP_joint" joint="right_thumb_MCP_joint" ctrllimited="true" ctrlrange="-1 1"/> 
        <motor name="right_thumb_PIP_joint" joint="right_thumb_PIP_joint" ctrllimited="true" ctrlrange="-1 1"/>
        <motor name="right_thumb_DIP_joint" joint="right_thumb_DIP_joint" ctrllimited="true" ctrlrange="-1 1"/>
    </actuator>

    

    <sensor>
        <contact name="thumb_contact" body1="right_thumb_distal_link" body2="obj1" num="1" data="found force pos normal tangent" reduce="maxforce"/>
        <contact name="index_contact" body1="right_index_distal_link" body2="obj1" num="1" data="found force pos normal tangent" reduce="maxforce"/> 
    </sensor>

</mujoco>