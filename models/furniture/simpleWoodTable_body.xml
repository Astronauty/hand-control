        <geom class="viz_simpleWoodTable" type="box" size="0.03 0.03 0.2875" pos="0.565 -0.235 0.2875"/>

        <!-- COLLISION geoms. Only the tabletop is named `table` (the arm's collision list
             references it); the apron/legs are unnamed collision boxes. -->
