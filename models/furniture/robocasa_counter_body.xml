<mujocoinclude>
<!-- RoboCasa-style counter body. ENLARGED to a 1.4 x 1.0 m marble top (half 0.7 x 0.5,
     0.025 thick, was 1.3 x 0.75) so objects/bin have a wide margin and don't roll off during
     pick-and-place (matches the enlarged wood table). Top surface at z = TABLE_TOP_COUNTER =
     0.86 (a realistic kitchen-counter height). The robot base mounts ON the top (loader
     raises base_link to TABLE_TOP_Z). The tabletop the arm avoids is named `table` at scene
     level, so the top box is named `table` here to plug into _STATIC_OBSTACLE_GEOMS with no
     code change. Visual geoms (group 1, no collision) carry the marble material; a matching
     named collision box sits under the top. -->
    <body name="robocasa_counter" pos="0 0 0">
        <!-- Marble top: visual + a named collision box -->
        <geom type="box" size="0.7 0.5 0.025" pos="0 0 0.835" material="counter_top"
              group="1" contype="0" conaffinity="0"/>
        <geom name="table" type="box" size="0.7 0.5 0.025" pos="0 0 0.835"
              class="counter_col" mass="60"/>

        <!-- Base cabinet body (marble-clad box under the top). Visual + collision. -->
        <geom type="box" size="0.67 0.475 0.405" pos="0 0 0.405" material="counter_base"
              group="1" contype="0" conaffinity="0"/>
        <geom type="box" size="0.67 0.475 0.405" pos="0 0 0.405" class="counter_col"/>
    </body>
</mujocoinclude>
