<mujoco model="kinova_leap scene">
  <include file="kinova_leap.xml"/>

  <statistic center="0.3 0 0.45" extent="0.8" meansize="0.05"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.1 0.1 0.1" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <!-- Exclude the base_link/shoulder_link self-contact: these mesh geoms overlap by ~12mm
       at the gen3 home keyframe (verified in standalone gen3.xml — inherent to the model).
       Without this exclusion the persistent contact forces destabilise the PD controller. -->
  <contact>
    <exclude body1="base_link" body2="shoulder_link"/>
  </contact>

  <!-- Wood table for the "clear the table" task: the reachy2/furniture_sim simpleWoodTable
       (dark walnut planks, box-primitive collision, top surface at z=0.625 = TABLE_TOP_Z).
       The robot base is mounted ON this table top (base_link raised to TABLE_TOP_Z in the
       loader, kinova_leap_pick_place.py), the common tabletop-manipulation convention, so
       grasps are level with the base. TABLE_TOP_Z=0.625 is mirrored in the Python
       (object rest z + _randomize_objects z_rest) — keep in sync. -->
  <include file="furniture/simpleTable_asset.xml"/>

  <worldbody>
    <light pos="0 0 1.5" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>
    <!-- Table centered under the robot workspace (arm base at ~(0,0), reaches +y forward). -->
    <body name="table" pos="0.0 0.25 0.0">
      <include file="furniture/simpleWoodTable_body.xml"/>
    </body>
  </worldbody>
</mujoco>
